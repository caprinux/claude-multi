#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# codex-multi — Run multiple Codex CLI instances with different accounts
# ─────────────────────────────────────────────────────────────────────────────

VERSION="1.0.0"
PROFILES_DIR="${CODEX_MULTI_HOME:-$HOME/.codex-profiles}"
MAIN_CODEX_DIR="$HOME/.codex"

# Shared directories — symlinked so all profiles share sessions/history
SHARED_DIRS=(sessions memories skills)
SHARED_FILES=(history.jsonl)

# Colors
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

die()  { printf '%s\n' "${RED}error:${NC} $*" >&2; exit 1; }
info() { printf '%s\n' "${BLUE}>>>${NC} $*"; }
warn() { printf '%s\n' "${YELLOW}warning:${NC} $*" >&2; }
ok()   { printf '%s\n' "${GREEN}ok:${NC} $*"; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not found in PATH"
}

profile_dir() {
    echo "$PROFILES_DIR/$1"
}

profile_exists() {
    [[ -d "$(profile_dir "$1")" ]]
}

require_profile() {
    local name="$1"
    if [[ -z "$name" ]]; then die "profile name required"; fi
    profile_exists "$name" || die "profile '${name}' does not exist. Run: codex-multi list"
}

validate_profile_name() {
    local name="$1"
    if [[ -z "$name" ]]; then die "profile name required"; fi
    [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "profile name must be alphanumeric (hyphens and underscores allowed)"
    if [[ "$name" == "." || "$name" == ".." ]]; then die "invalid profile name"; fi
}

get_profile_email() {
    local dir
    dir="$(profile_dir "$1")"
    if [[ -f "$dir/.email" ]]; then
        cat "$dir/.email"
        return
    fi
    local auth_file="$dir/auth.json"
    if [[ -f "$auth_file" ]]; then
        python3 -c "
import json, base64
try:
    d = json.load(open('$auth_file'))
    tokens = d.get('tokens') or {}
    id_token = tokens.get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        info = json.loads(base64.urlsafe_b64decode(payload))
        print(info.get('email', 'unknown'))
    elif d.get('OPENAI_API_KEY'):
        print('api-key')
    else:
        print('unknown')
except: print('unknown')
" 2>/dev/null
    else
        echo "not logged in"
    fi
}

get_profile_auth_mode() {
    local dir
    dir="$(profile_dir "$1")"
    local auth_file="$dir/auth.json"
    if [[ -f "$auth_file" ]]; then
        python3 -c "
import json
try:
    d = json.load(open('$auth_file'))
    print(d.get('auth_mode', 'unknown'))
except: print('unknown')
" 2>/dev/null
    else
        echo "none"
    fi
}

get_profile_status() {
    local dir
    dir="$(profile_dir "$1")"
    local auth_file="$dir/auth.json"
    if [[ ! -f "$auth_file" ]]; then
        echo "no credentials"
        return
    fi
    python3 -c "
import json, base64, time
try:
    d = json.load(open('$auth_file'))
    mode = d.get('auth_mode', '')
    if mode == 'apiKey' and d.get('OPENAI_API_KEY'):
        print('active (api key)')
    elif mode in ('chatgpt', 'chatgptAuthTokens'):
        tokens = d.get('tokens') or {}
        access = tokens.get('access_token', '')
        if access:
            payload = access.split('.')[1]
            payload += '=' * (4 - len(payload) % 4)
            info = json.loads(base64.urlsafe_b64decode(payload))
            exp = info.get('exp', 0)
            if exp > time.time():
                print('active')
            elif tokens.get('refresh_token'):
                print('expired (will auto-refresh)')
            else:
                print('expired')
        elif tokens.get('refresh_token'):
            print('has refresh token')
        else:
            print('no token')
    else:
        print('unknown')
except: print('unknown')
" 2>/dev/null
}

setup_shared_symlinks() {
    local name="$1"
    local dir
    dir="$(profile_dir "$name")"

    # Ensure shared directories exist in main config
    for d in "${SHARED_DIRS[@]}"; do
        mkdir -p "$MAIN_CODEX_DIR/$d"
    done

    # Ensure shared files exist in main config
    for f in "${SHARED_FILES[@]}"; do
        [[ -f "$MAIN_CODEX_DIR/$f" ]] || touch "$MAIN_CODEX_DIR/$f"
    done

    # Symlink shared directories
    for d in "${SHARED_DIRS[@]}"; do
        local target="$dir/$d"
        if [[ -L "$target" ]]; then
            local current
            current="$(readlink "$target")"
            if [[ "$current" != "$MAIN_CODEX_DIR/$d" ]]; then
                rm "$target"
                ln -s "$MAIN_CODEX_DIR/$d" "$target"
            fi
        elif [[ -d "$target" ]]; then
            if [[ "$(ls -A "$target" 2>/dev/null)" ]]; then
                cp -a "$target/"* "$MAIN_CODEX_DIR/$d/" 2>/dev/null || true
            fi
            rm -rf "$target"
            ln -s "$MAIN_CODEX_DIR/$d" "$target"
        else
            ln -s "$MAIN_CODEX_DIR/$d" "$target"
        fi
    done

    # Symlink shared files
    for f in "${SHARED_FILES[@]}"; do
        local target="$dir/$f"
        if [[ -L "$target" ]]; then
            local current
            current="$(readlink "$target")"
            if [[ "$current" != "$MAIN_CODEX_DIR/$f" ]]; then
                rm "$target"
                ln -s "$MAIN_CODEX_DIR/$f" "$target"
            fi
        elif [[ -f "$target" ]]; then
            cat "$target" >> "$MAIN_CODEX_DIR/$f" 2>/dev/null || true
            rm "$target"
            ln -s "$MAIN_CODEX_DIR/$f" "$target"
        else
            ln -s "$MAIN_CODEX_DIR/$f" "$target"
        fi
    done
}

sync_mcp_config_to_profile() {
    local name="$1"
    local dir
    dir="$(profile_dir "$name")"
    local main_config="$MAIN_CODEX_DIR/config.toml"
    local profile_config="$dir/config.toml"
    [[ -f "$main_config" ]] || return 0
    [[ -f "$profile_config" ]] || return 0
    python3 -c "
try:
    import tomllib
except ImportError:
    import tomli as tomllib
import re

with open('$main_config', 'rb') as f:
    main = tomllib.load(f)
with open('$profile_config', 'rb') as f:
    profile = tomllib.load(f)

mcp = main.get('mcp_servers')
if mcp is None:
    exit(0)

# Read raw profile config and replace/append mcp_servers section
with open('$profile_config', 'r') as f:
    content = f.read()

with open('$main_config', 'r') as f:
    main_content = f.read()

# Extract all [mcp_servers.*] sections from main config
mcp_lines = []
in_mcp = False
for line in main_content.splitlines():
    if re.match(r'^\[mcp_servers', line):
        in_mcp = True
        mcp_lines.append(line)
    elif re.match(r'^\[', line) and not re.match(r'^\[mcp_servers', line):
        in_mcp = False
    elif in_mcp:
        mcp_lines.append(line)

# Remove existing mcp_servers sections from profile
new_lines = []
in_mcp = False
for line in content.splitlines():
    if re.match(r'^\[mcp_servers', line):
        in_mcp = True
        continue
    elif re.match(r'^\[', line) and not re.match(r'^\[mcp_servers', line):
        in_mcp = False
    if not in_mcp:
        new_lines.append(line)

# Append mcp sections
result = '\n'.join(new_lines).rstrip()
if mcp_lines:
    result += '\n\n' + '\n'.join(mcp_lines) + '\n'

with open('$profile_config', 'w') as f:
    f.write(result)
" 2>/dev/null || true
}

launch_profile_shell() {
    local name="$1" dir="$2"
    local shell_name
    shell_name="$(basename "$SHELL")"

    local rcfile
    rcfile="$(mktemp)"

    case "$shell_name" in
        zsh)
            local zdir
            zdir="$(mktemp -d)"
            cat > "$zdir/.zshrc" <<RCEOF
[ -f "\$HOME/.zshrc" ] && source "\$HOME/.zshrc"
PS1="(%F{cyan}${name}%f) \$PS1"
RCEOF
            CODEX_HOME="$dir" CODEX_MULTI_PROFILE="$name" ZDOTDIR="$zdir" exec "$SHELL"
            ;;
        bash)
            cat > "$rcfile" <<RCEOF
[ -f "\$HOME/.bashrc" ] && source "\$HOME/.bashrc"
PS1="(${name}) \$PS1"
RCEOF
            CODEX_HOME="$dir" CODEX_MULTI_PROFILE="$name" exec "$SHELL" --rcfile "$rcfile"
            ;;
        *)
            CODEX_HOME="$dir" CODEX_MULTI_PROFILE="$name" PS1="(${name}) \$ " exec "$SHELL"
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_login() {
    local name="${1:-}"
    validate_profile_name "$name"

    local dir
    dir="$(profile_dir "$name")"
    mkdir -p "$dir"
    chmod 700 "$dir"

    # Set up shared session symlinks and config
    setup_shared_symlinks "$name"
    if [[ -f "$MAIN_CODEX_DIR/config.toml" ]]; then
        cp "$MAIN_CODEX_DIR/config.toml" "$dir/config.toml"
    fi

    info "Logging into profile '${BOLD}${name}${NC}'..."
    echo ""
    CODEX_HOME="$dir" codex login

    # Capture email after successful login
    if [[ -f "$dir/auth.json" ]]; then
        local email
        email="$(python3 -c "
import json, base64
try:
    d = json.load(open('$dir/auth.json'))
    tokens = d.get('tokens') or {}
    id_token = tokens.get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        info = json.loads(base64.urlsafe_b64decode(payload))
        print(info.get('email', 'unknown'))
    elif d.get('OPENAI_API_KEY'):
        print('api-key')
    else:
        print('unknown')
except: print('unknown')
" 2>/dev/null)"
        echo "$email" > "$dir/.email"
        echo ""
        ok "Logged into profile '${BOLD}${name}${NC}' — ${CYAN}${email}${NC}"
    else
        warn "Login may not have completed. Run 'codex-multi status ${name}' to check."
    fi
}

cmd_save() {
    local name="${1:-}"
    validate_profile_name "$name"

    local main_auth="$MAIN_CODEX_DIR/auth.json"
    if [[ ! -f "$main_auth" ]]; then
        die "No credentials found in ${MAIN_CODEX_DIR}. Login first with: codex login"
    fi

    local current_email
    current_email="$(python3 -c "
import json, base64
try:
    d = json.load(open('$main_auth'))
    tokens = d.get('tokens') or {}
    id_token = tokens.get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        info = json.loads(base64.urlsafe_b64decode(payload))
        print(info.get('email', 'unknown'))
    elif d.get('OPENAI_API_KEY'):
        print('api-key')
    else:
        print('unknown')
except: print('unknown')
" 2>/dev/null)"

    if profile_exists "$name"; then
        local existing_email
        existing_email="$(get_profile_email "$name")"
        warn "Profile '${name}' already exists (${existing_email})"
        echo "Overwrite with current account (${CYAN}${current_email}${NC})? [y/N]"
        read -rp "> " confirm
        [[ "$confirm" =~ ^[yY]$ ]] || die "Aborted."
    fi

    local dir
    dir="$(profile_dir "$name")"
    mkdir -p "$dir"
    chmod 700 "$dir"

    # Copy auth credentials
    cp "$main_auth" "$dir/auth.json"
    chmod 600 "$dir/auth.json"

    # Save email for quick identification
    echo "$current_email" > "$dir/.email"

    # Copy config
    if [[ -f "$MAIN_CODEX_DIR/config.toml" ]]; then
        cp "$MAIN_CODEX_DIR/config.toml" "$dir/config.toml"
    fi

    # Copy rules
    if [[ -d "$MAIN_CODEX_DIR/rules" ]]; then
        cp -a "$MAIN_CODEX_DIR/rules" "$dir/" 2>/dev/null || true
    fi

    # Set up shared symlinks
    setup_shared_symlinks "$name"

    local mode
    mode="$(get_profile_auth_mode "$name")"
    ok "Saved profile '${BOLD}${name}${NC}' — ${CYAN}${current_email}${NC} (${mode})"
}

cmd_list() {
    mkdir -p "$PROFILES_DIR"

    local profiles=()
    while IFS= read -r -d '' d; do
        profiles+=("$(basename "$d")")
    done < <(find "$PROFILES_DIR" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

    if [[ ${#profiles[@]} -eq 0 ]]; then
        echo "${DIM}No profiles yet. Create one with:${NC} codex-multi save <name>"
        return
    fi

    echo ""
    printf "  ${BOLD}%-20s %-35s %-15s %-25s${NC}\n" "PROFILE" "EMAIL" "AUTH MODE" "STATUS"
    printf "  %-20s %-35s %-15s %-25s\n" "───────" "─────" "─────────" "──────"

    for name in "${profiles[@]}"; do
        local email mode status
        email="$(get_profile_email "$name")"
        mode="$(get_profile_auth_mode "$name")"
        status="$(get_profile_status "$name")"

        local status_color="$NC"
        case "$status" in
            active*)                status_color="$GREEN" ;;
            "expired (will auto"*|"has refresh"*) status_color="$YELLOW" ;;
            expired|"no token"|"no credentials") status_color="$RED" ;;
        esac

        printf "  %-20s %-35s %-15s ${status_color}%-25s${NC}\n" \
            "$name" "$email" "$mode" "$status"
    done
    echo ""
}

cmd_run() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then die "usage: codex-multi run <profile> [codex args...]"; fi
    require_profile "$name"
    shift

    local dir
    dir="$(profile_dir "$name")"

    sync_config_if_needed "$name"
    setup_shared_symlinks "$name"

    local email
    email="$(get_profile_email "$name")"
    info "Running Codex as ${CYAN}${email}${NC} (profile: ${BOLD}${name}${NC})"
    echo ""

    exec env CODEX_HOME="$dir" codex "$@"
}

cmd_status() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        cmd_list
        return
    fi
    require_profile "$name"

    local dir
    dir="$(profile_dir "$name")"

    info "Auth status for profile '${BOLD}${name}${NC}':"
    echo ""
    CODEX_HOME="$dir" codex login status 2>&1 || true
}

cmd_delete() {
    local name="${1:-}"
    validate_profile_name "$name"
    require_profile "$name"

    local dir
    dir="$(profile_dir "$name")"

    local email
    email="$(get_profile_email "$name")"

    echo "Delete profile '${BOLD}${name}${NC}' (${email})?"
    read -rp "Type the profile name to confirm: " confirm
    [[ "$confirm" == "$name" ]] || die "Aborted."

    info "Logging out..."
    CODEX_HOME="$dir" codex logout 2>/dev/null || true

    rm -rf "$dir"
    ok "Profile '${name}' deleted."
}

cmd_logout() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then die "usage: codex-multi logout <profile>"; fi
    require_profile "$name"

    local dir
    dir="$(profile_dir "$name")"

    info "Logging out profile '${BOLD}${name}${NC}'..."
    CODEX_HOME="$dir" codex logout
    ok "Profile '${name}' logged out."
}

cmd_rename() {
    local old="${1:-}"
    local new="${2:-}"
    if [[ -z "$old" || -z "$new" ]]; then die "usage: codex-multi rename <old-name> <new-name>"; fi
    validate_profile_name "$old"
    validate_profile_name "$new"
    require_profile "$old"
    if profile_exists "$new"; then die "profile '${new}' already exists"; fi

    mv "$(profile_dir "$old")" "$(profile_dir "$new")"
    ok "Renamed '${old}' -> '${new}'"
}

cmd_sync() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then die "usage: codex-multi sync <profile>"; fi
    require_profile "$name"

    sync_settings_to_profile "$name"
    ok "Settings synced to profile '${name}'"
}

sync_settings_to_profile() {
    local name="$1"
    local dir
    dir="$(profile_dir "$name")"

    if [[ -f "$MAIN_CODEX_DIR/config.toml" ]]; then
        cp "$MAIN_CODEX_DIR/config.toml" "$dir/config.toml"
    fi
    if [[ -d "$MAIN_CODEX_DIR/rules" ]]; then
        cp -a "$MAIN_CODEX_DIR/rules" "$dir/" 2>/dev/null || true
    fi

    setup_shared_symlinks "$name"
}

sync_config_if_needed() {
    local name="$1"
    local dir
    dir="$(profile_dir "$name")"

    # Sync MCP servers from main config
    sync_mcp_config_to_profile "$name"
}

cmd_which() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then die "usage: codex-multi which <profile>"; fi
    require_profile "$name"
    echo "$(profile_dir "$name")"
}

cmd_shell() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then die "usage: codex-multi shell <profile>"; fi
    require_profile "$name"

    local dir
    dir="$(profile_dir "$name")"
    local email
    email="$(get_profile_email "$name")"

    setup_shared_symlinks "$name"

    info "Opening shell with CODEX_HOME set to profile '${BOLD}${name}${NC}' (${email})"
    info "Any 'codex' commands in this shell will use this profile."
    info "Type 'exit' to return to your normal shell."
    echo ""

    launch_profile_shell "$name" "$dir"
}

cmd_help() {
    cat <<EOF

${BOLD}codex-multi${NC} v${VERSION} — Run multiple Codex CLI instances with different accounts

${BOLD}USAGE${NC}
    codex-multi <command> [args]

${BOLD}ACCOUNT MANAGEMENT${NC}
    login   <profile>              Login directly into a named profile
    save    <profile>              Save currently logged-in account as a named profile
    logout  <profile>              Logout a profile (invalidate tokens)
    status  [profile]              Show auth status (all profiles if no name given)
    list                           List all profiles with account info
    delete  <profile>              Delete a profile and its credentials
    rename  <old> <new>            Rename a profile

${BOLD}RUNNING CODEX${NC}
    run     <profile> [args...]    Run Codex using a specific profile
    shell   <profile>              Open a subshell with the profile's config active

${BOLD}CONFIGURATION${NC}
    sync    <profile>              Sync config/rules from main ~/.codex to profile
    which   <profile>              Print the config directory path for a profile

${BOLD}EXAMPLES${NC}
    ${DIM}# Login directly into a profile${NC}
    codex-multi login work

    ${DIM}# Or save the currently logged-in account as a profile${NC}
    codex-multi save personal

    ${DIM}# Run Codex with your work account${NC}
    codex-multi run work

    ${DIM}# Run Codex with personal account and a prompt${NC}
    codex-multi run personal "fix the tests"

    ${DIM}# Run two instances simultaneously (in separate terminals)${NC}
    codex-multi run work           ${DIM}# terminal 1${NC}
    codex-multi run personal       ${DIM}# terminal 2${NC}

    ${DIM}# Open a shell where all 'codex' commands use the work profile${NC}
    codex-multi shell work

${BOLD}SESSION SHARING${NC}
    Sessions, conversation history, and memories are shared across all
    profiles via symlinks to ~/.codex/. Credentials remain isolated.

${BOLD}ENVIRONMENT${NC}
    CODEX_MULTI_HOME    Override profiles directory (default: ~/.codex-profiles)

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    need_cmd codex
    need_cmd python3

    local cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        login|l)        cmd_login "$@" ;;
        save|s)         cmd_save "$@" ;;
        list|ls)        cmd_list "$@" ;;
        run|r)          cmd_run "$@" ;;
        status|st)      cmd_status "$@" ;;
        delete|rm)      cmd_delete "$@" ;;
        logout)         cmd_logout "$@" ;;
        rename|mv)      cmd_rename "$@" ;;
        sync)           cmd_sync "$@" ;;
        which)          cmd_which "$@" ;;
        shell|sh)       cmd_shell "$@" ;;
        help|--help|-h) cmd_help ;;
        version|--version|-v) echo "codex-multi v${VERSION}" ;;
        *)              die "unknown command '${cmd}'. Run 'codex-multi help' for usage." ;;
    esac
}

main "$@"
